{
  "name": "switchyard-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Switchyard control room: the web UI served by the Switchyard gateway.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-mock.ts",
    "dev:mock:seed": "node scripts/dev-mock.ts --seed",
    "mock": "node mock/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && node scripts/e2e.ts --project=e2e",
    "screenshots": "pnpm build && node scripts/e2e.ts --project=screenshots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "~8.3.1",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
